{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "screen-share-desktop",
  "version": "0.1.0",
  "identifier": "io.github.hiroshimorowaka.screenshare-desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Screen Share",
        "url": "https://screen-share-h0rb5w.fly.dev/",
        "width": 1100,
        "height": 750
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
